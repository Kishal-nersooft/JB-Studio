<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_beauty_branch" model="ir.sequence">
            <field name="name">Beauty Branch Sequence</field>
            <field name="code">beauty.branch</field>
            <field name="prefix">BR</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_salon_appointment" model="ir.sequence">
            <field name="name">Salon Appointment Sequence</field>
            <field name="code">salon.appointment</field>
            <field name="prefix">APPT</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
