    <record id="action_customer_deposit" model="ir.actions.act_window">
        <field name="name">Customer Deposits</field>
        <field name="res_model">beauty.customer.deposit</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_customer_deposit_action_wizard_form" model="ir.ui.view">
        <field name="name">beauty.customer.deposit.action.wizard.form</field>
        <field name="model">beauty.customer.deposit.action.wizard</field>
        <field name="arch" type="xml">
            <form string="Deposit Action">
                <group>
                    <field name="appointment_ref" readonly="1"/>
                    <field name="branch_id" readonly="1"/>
                    <field name="company_id" readonly="1"/>
                    <field name="action_type"/>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
