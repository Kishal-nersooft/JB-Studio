<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_salon_appointment_cancel_wizard_form" model="ir.ui.view">
        <field name="name">salon.appointment.cancel.wizard.form</field>
        <field name="model">salon.appointment.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Appointment">
                <field name="appointment_id" invisible="1"/>
                <group>
                    <!-- Optional on purpose: staff should never be blocked from
                         cancelling because they cannot find a matching reason. -->
                    <field name="reason_id"
                           options="{'no_create_edit': True}"
                           placeholder="Select a reason (optional)"/>
                    <field name="note" placeholder="Anything the list does not cover"/>
                </group>
                <footer>
                    <button name="action_confirm_cancel" string="Cancel Appointment"
                            type="object" class="btn-danger"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_salon_appointment_cancel_wizard" model="ir.actions.act_window">
        <field name="name">Cancel Appointment</field>
        <field name="res_model">salon.appointment.cancel.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
