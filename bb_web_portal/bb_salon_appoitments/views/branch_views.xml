<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--branch list view-->
    <record id="view_branch_list" model="ir.ui.view">
        <field name="name">beauty.branch.list</field>
        <field name="model">beauty.branch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="company_id"/>
                <field name="is_franchise"/>
                <field name="beautician_count"/>
                <field name="city"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <!--branch form view-->
    <record id="view_branch_form" model="ir.ui.view">
        <field name="name">beauty.branch.form</field>
        <field name="model">beauty.branch</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" name="action_view_beauticians"
                                type="object" icon="fa-users">
                            <div class="o_stat_info">
                                <field name="beautician_count" class="o_stat_value"/>
                                <span class="o_stat_text"> Beauticians</span>
                            </div>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar" options='{"preview_image": "image", "size": [120, 120]}'/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Branch Name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="phone" widget="phone" placeholder="+61 …"/>
                            <label for="street" string="Address"/>
                            <div class="o_address_format">
                                <field name="street" placeholder="Street..." class="o_address_street"/>
                                <field name="street2" placeholder="Street 2..." class="o_address_street"/>
                                <field name="city" placeholder="City" class="o_address_city"/>
                                <field name="state_id" class="o_address_state" placeholder="State" options="{&quot;no_open&quot;: True}"/>
                                <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                <field name="country_id" placeholder="Country" class="o_address_country" options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
                            </div>
                        </group>
                        <group>
                            <field name="pos_config_id"/>
                            <field name="website_id"/>
                            <field name="area_manager_id"
                                   domain="[('is_beautician', '=', False)]"
                                   options="{'no_create': True}"/>
                            <field name="beautician_count" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="branch_info" string="Branch Info">
                            <group>
                                <group>
                                    <field name="booking_fee"/>
                                    <field name="work_start_hour" widget="float_time"/>
                                    <field name="saturday_surcharge_percent" widget="percentage"/>
                                </group>
                                <group>
                                    <field name="work_end_hour" widget="float_time"/>
                                    <field name="tz"/>
                                    <field name="sunday_surcharge_percent" widget="percentage"/>
                                </group>
                            </group>
                        </page>
                        <page name="branch_areas" string="Areas">
                            <field name="area_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_beauty_branch" model="ir.actions.act_window">
        <field name="name">Branches</field>
        <field name="res_model">beauty.branch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
