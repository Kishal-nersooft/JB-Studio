    <template id="s_bnb_v2_newsletter" name="BnB Newsletter V2">
        <section id="bnb_newsletter" class="s_bnb_v2_newsletter py-5 o_cc1" data-snippet="s_bnb_v2_newsletter" data-name="BnB Newsletter">
            <div class="container">
                <div class="text-center">
                    <div class="bnb-divider mx-auto mb-2"></div>
                    <p class="bnb-news-kicker mb-1">DON'T MISS OUT</p>
                    <h2 class="bnb-section-title mb-4">Sign Up With Newsletter</h2>
                </div>
                <form action="/bnb/newsletter/subscribe" method="post" class="row g-3 bnb-news-form">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">Name *</label>
                        <input type="text" name="name" class="form-control" placeholder="Name" required="required"/>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">Email *</label>
                        <input type="email" name="email" class="form-control" placeholder="Email" required="required"/>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">Phone *</label>
                        <input type="tel" name="phone" class="form-control" placeholder="Phone" required="required"/>
                    </div>
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label">Select Store *</label>
                        <select name="branch_id" class="form-select" required="required">
                            <option value="">Select Store</option>
                            <!-- get_current_website(), not request.website: the
                                 website editor renders this snippet over jsonrpc
                                 (ir.ui.view.render_public_asset), and there is no
                                 request.website on a non-website route. -->
                            <t t-foreach="request.env['beauty.branch'].sudo().search([('active', '=', True), ('company_id', '=', request.env['website'].get_current_website().company_id.id)], order='name')" t-as="branch">
                                <option t-att-value="branch.id" t-out="branch.name"/>
                            </t>
                        </select>
                    </div>
                    <div class="col-12 text-center mt-3">
                        <button type="submit" class="btn btn-dark px-5">SUBSCRIBE</button>
                    </div>
                </form>
            </div>
            <a href="/book-online" class="bnb-book-sidebar">Book Online</a>
        </section>
    </template>

