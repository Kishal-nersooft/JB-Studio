<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Browz & Beauty custom website footer.
        Site-wide, but scoped to the "Browz & Beauty" website only: on that site
        the default Odoo footer + copyright bar are hidden and replaced by this
        branded footer (Our Locations / Connect / Review us + store-links bar).
        The other brand websites keep their existing footer.
        Content, images and links mirror the live site browzandbeauty.com.au;
        icon assets are self-hosted under static/img/footer/.
    -->
    <template id="bb_website_footer" inherit_id="website.layout"
              name="Browz &amp; Beauty Footer" priority="90">

        <!-- Hide the default footer on the Browz & Beauty website only -->
        <xpath expr="//div[@id='footer']" position="attributes">
            <attribute name="t-if">not no_footer and not (website and website.name.lower() == 'browz &amp; beauty')</attribute>
        </xpath>
        <!-- Hide the default "Copyright" bar on Browz & Beauty (it has its own bar) -->
        <xpath expr="//div[hasclass('o_footer_copyright')]" position="attributes">
            <attribute name="t-if">not no_copyright and not (website and website.name.lower() == 'browz &amp; beauty')</attribute>
        </xpath>

        <!-- Branded Browz & Beauty footer -->
        <xpath expr="//div[@id='footer']" position="after">
            <div id="footer" class="bb_footer" t-ignore="true"
                 t-if="not no_footer and website and website.name.lower() == 'browz &amp; beauty'">
                <section class="bb_footer_main">
                    <div class="container">
                        <div class="row">
                            <!-- Our Locations -->
                            <div class="col-lg-4 col-md-6 bb_footer_col">
                                <h5 class="bb_footer_title">Our Locations</h5>
                                <ul class="list-unstyled bb_footer_locations">
                                    <li><a href="https://www.google.com/maps/place/Browz+%26+Beauty+Westfield+Belconnen/@-35.2923223,149.0056184,12z/data=!3m1!5s0x6b17ad71209b4b91:0x49947be24b561f30!4m9!1m2!2m1!1sBrowz+%26+Beauty+Westfield+belconnen!3m5!1s0x6b17adb7aaa50131:0x314e265e0c2e5af6!8m2!3d-35.2382093!4d149.065118" target="_blank">Westfield Belconnen, ACT</a></li>
                                    <li><a href="https://www.google.com/maps/place/Browz+%26+Beauty+Westfield+Marion/@-35.0172313,138.5408144,17z/data=!3m1!4b1!4m5!3m4!1s0x6ab0da6ec4d266ab:0x259c85402d14d1bc!8m2!3d-35.0172313!4d138.5430031" target="_blank">Westfield Marion, SA</a></li>
                                    <li><a href="https://www.google.com/maps/place/Browz+%26+Beauty+Westfield+Woden/@-35.3464756,149.0840105,17z/data=!3m2!4b1!5s0x6b17b4bcbbce9a63:0x6e3ce34b35d5577d!4m5!3m4!1s0x6b17b4bcb9d4bd1f:0x2f68d70951a495ba!8m2!3d-35.3464756!4d149.0861992" target="_blank">Westfield Woden, ACT</a></li>
                                    <li><a href="https://www.google.com/maps/place/Browz+%26+Beauty+Mitchell+Centre/@-12.4636057,130.7699848,12z/data=!4m9!1m2!2m1!1sbrowz+and+beauty+darwin+mitchell+centre!3m5!1s0x2cc09108623beecb:0x5b22f6c568c04728!8m2!3d-12.4636057!4d130.8400226" target="_blank">Mitchell Centre, NT</a></li>
                                    <li><a href="https://www.google.com/maps/place/Browz+%26+Beauty+Gateway+Shopping+Centre/@-12.471435,130.9812263,17z/data=!3m1!4b1!4m5!3m4!1s0x2cc0bd395afb5c71:0xbe33905998d78e25!8m2!3d-12.471435!4d130.983415" target="_blank">Gateway Shopping Centre, NT</a></li>
                                    <li><a href="https://www.google.com/maps/place/Browz+%26+Beauty+Casuarina+Square/@-12.3749302,130.8793332,17z/data=!3m1!4b1!4m5!3m4!1s0x2cc0951abb08f713:0x54d243939175a97f!8m2!3d-12.3749302!4d130.8815219" target="_blank">Casuarina Square, NT</a></li>
                                </ul>
                            </div>
                            <!-- Connect With Us -->
                            <div class="col-lg-4 col-md-6 bb_footer_col">
                                <h5 class="bb_footer_title">Connect With Us</h5>
                                <p class="bb_footer_email">
                                    <img src="/bnb_portal_appointment/static/img/footer/mail.png" alt="Email" class="bb_mail_icon"/>
                                    <a href="mailto:enquiries@browzandbeauty.com.au">enquiries@browzandbeauty.com.au</a>
                                </p>
                                <div class="bb_footer_social">
                                    <a href="https://www.facebook.com/browzandbeauty/?fref=ts" target="_blank" aria-label="Facebook">
                                        <img src="/bnb_portal_appointment/static/img/footer/fb_icon.png" alt="Facebook"/>
                                    </a>
                                    <a href="https://www.instagram.com/browzandbeauty/" target="_blank" aria-label="Instagram">
                                        <img src="/bnb_portal_appointment/static/img/footer/insta_icon.png" alt="Instagram"/>
                                    </a>
                                    <a href="https://www.pinterest.com.au/browzandbeautyau/" target="_blank" aria-label="Pinterest">
                                        <img src="/bnb_portal_appointment/static/img/footer/pinterest_icon.png" alt="Pinterest"/>
                                    </a>
                                </div>
                            </div>
                            <!-- Review Us -->
                            <div class="col-lg-4 col-md-12 bb_footer_col">
                                <h5 class="bb_footer_title">Review Us</h5>
                                <!-- The score and star image that used to sit beside each badge were
                                     fixed text ("Rated 4.7/5 from 315 reviews", "Rated 4.7/5 Based on
                                     47 Customer Reviews"). Nothing recalculated them, so they stated a
                                     rating and a review count that stopped being true the day after
                                     they were typed. The badges still link to the real Facebook and
                                     Google review pages, where the current score is shown by the
                                     platform itself. -->
                                <div class="bb_review_item">
                                    <a href="https://www.facebook.com/browzandbeauty/reviews/?ref=page_internal" target="_blank" aria-label="Review us on Facebook">
                                        <img src="/bnb_portal_appointment/static/img/footer/fb_badge.png" alt="Facebook" class="bb_review_badge"/>
                                    </a>
                                    <div class="bb_review_text">
                                        <span class="bb_review_caption">Review us on Facebook</span>
                                    </div>
                                </div>
                                <div class="bb_review_item">
                                    <a href="https://bit.ly/3ekQ6UB" target="_blank" aria-label="Review us on Google">
                                        <img src="/bnb_portal_appointment/static/img/footer/google_badge.png" alt="Google" class="bb_review_badge"/>
                                    </a>
                                    <div class="bb_review_text">
                                        <span class="bb_review_caption">Review us on Google</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
                <!-- Bottom store-links bar -->
                <section class="bb_footer_bottom">
                    <div class="container">
                        <ul class="list-inline bb_footer_stores mb-0">
                            <li class="list-inline-item">
                                <a href="https://www.google.com/maps/place/Browz+%26+Beauty+Westfield+Marion/@-35.0172313,138.5408144,17z/data=!3m1!4b1!4m5!3m4!1s0x6ab0da6ec4d266ab:0x259c85402d14d1bc!8m2!3d-35.0172313!4d138.5430031" target="_blank">
                                    <img src="/bnb_portal_appointment/static/img/footer/gmb_icon.png" alt="" class="bb_gmb_icon"/> - Marion</a>
                            </li>
                            <li class="list-inline-item bb_sep">|</li>
                            <li class="list-inline-item">
                                <a href="https://www.google.com/maps/place/Browz+%26+Beauty+Westfield+Woden/@-35.3464756,149.0840105,17z/data=!3m2!4b1!5s0x6b17b4bcbbce9a63:0x6e3ce34b35d5577d!4m5!3m4!1s0x6b17b4bcb9d4bd1f:0x2f68d70951a495ba!8m2!3d-35.3464756!4d149.0861992" target="_blank">
                                    <img src="/bnb_portal_appointment/static/img/footer/gmb_icon.png" alt="" class="bb_gmb_icon"/> - Woden</a>
                            </li>
                            <li class="list-inline-item bb_sep">|</li>
                            <li class="list-inline-item">
                                <a href="https://www.google.com/maps/place/Browz+%26+Beauty+Westfield+Belconnen/@-35.2923223,149.0056184,12z/data=!3m1!5s0x6b17ad71209b4b91:0x49947be24b561f30!4m9!1m2!2m1!1sBrowz+%26+Beauty+Westfield+belconnen!3m5!1s0x6b17adb7aaa50131:0x314e265e0c2e5af6!8m2!3d-35.2382093!4d149.065118" target="_blank">
                                    <img src="/bnb_portal_appointment/static/img/footer/gmb_icon.png" alt="" class="bb_gmb_icon"/> - Belconnen</a>
                            </li>
                            <li class="list-inline-item bb_sep">|</li>
                            <li class="list-inline-item">
                                <a href="https://www.google.com/maps/place/Browz+%26+Beauty+Gateway+Shopping+Centre/@-12.471435,130.9812263,17z/data=!3m1!4b1!4m5!3m4!1s0x2cc0bd395afb5c71:0xbe33905998d78e25!8m2!3d-12.471435!4d130.983415" target="_blank">
                                    <img src="/bnb_portal_appointment/static/img/footer/gmb_icon.png" alt="" class="bb_gmb_icon"/> - Gateway</a>
                            </li>
                            <li class="list-inline-item bb_sep">|</li>
                            <li class="list-inline-item">
                                <a href="https://www.google.com/maps/place/Browz+%26+Beauty+Casuarina+Square/@-12.3749302,130.8793332,17z/data=!3m1!4b1!4m5!3m4!1s0x2cc0951abb08f713:0x54d243939175a97f!8m2!3d-12.3749302!4d130.8815219" target="_blank">
                                    <img src="/bnb_portal_appointment/static/img/footer/gmb_icon.png" alt="" class="bb_gmb_icon"/> - Casuarina Square</a>
                            </li>
                            <li class="list-inline-item bb_sep">|</li>
                            <li class="list-inline-item">
                                <a href="https://www.google.com/maps/place/Browz+%26+Beauty+Mitchell+Centre/@-12.4636057,130.7699848,12z/data=!4m9!1m2!2m1!1sbrowz+and+beauty+darwin+mitchell+centre!3m5!1s0x2cc09108623beecb:0x5b22f6c568c04728!8m2!3d-12.4636057!4d130.8400226" target="_blank">
                                    <img src="/bnb_portal_appointment/static/img/footer/gmb_icon.png" alt="" class="bb_gmb_icon"/> - Mitchell Centre</a>
                            </li>
                        </ul>
                    </div>
                </section>
            </div>
        </xpath>
    </template>
</odoo>
