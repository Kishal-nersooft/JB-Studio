<odoo>
  <template id="secure_checkout" name="Secure booking payment">
    <t t-call="website.layout">
      <div class="salon-checkout-wrapper container py-4">
        <div class="row">
          <div class="col-12 mb-4">
            <h1 class="mb-2" style="font-size: 28px; font-weight: 700; color: #1a1a2e;">Complete your booking</h1>
            <p class="text-muted mb-0">Your booking is saved after your payment succeeds. Please complete payment within 20 minutes.</p>
          </div>
        </div>
        <div class="row">
          <!-- Left Column - Odoo Payment Form -->
          <div class="col-lg-7 col-md-7 mb-4">
            <div class="salon-checkout-card p-4">
              <h4 class="mb-3" style="font-weight: 600; color: #1a1a2e;">Select Payment Method</h4>
              <div id="salon_payment_method" class="mb-3">
                <t t-call="payment.form"/>
              </div>

              <!-- NAB wallet express buttons (Google Pay / Apple Pay) -->
              <t t-if="nab_wallet">
                <div class="nab-web-wallets"
                     t-att-data-provider-id="nab_wallet['provider_id']"
                     t-att-data-card-method-id="nab_wallet['card_method_id']"
                     t-att-data-access-token="nab_wallet['access_token']"
                     t-att-data-transaction-route="nab_wallet['transaction_route']"
                     t-att-data-landing-route="nab_wallet['landing_route']"
                     t-att-data-amount="nab_wallet['amount']"
                     t-att-data-currency="nab_wallet['currency']"
                     t-att-data-country="nab_wallet['country']"
                     t-att-data-is-test="nab_wallet['is_test']"
                     t-att-data-merchant-id="nab_wallet['merchant_id']"
                     t-att-data-google-merchant-id="nab_wallet['google_merchant_id']"
                     t-att-data-google="nab_wallet['google']"
                     t-att-data-apple="nab_wallet['apple']">
                    <div class="d-flex align-items-center my-3">
                        <hr class="flex-grow-1"/>
                        <span class="px-2 text-muted small">or pay with</span>
                        <hr class="flex-grow-1"/>
                    </div>
                    <button t-if="nab_wallet['google'] == '1'" type="button"
                            class="btn btn-dark w-100 mb-2 nab-web-wallet-btn"
                            data-wallet="google_pay">
                        <i class="fa fa-google me-2"/>Google Pay
                    </button>
                    <button t-if="nab_wallet['apple'] == '1'" type="button"
                            class="btn btn-dark w-100 nab-web-wallet-btn"
                            data-wallet="apple_pay">
                        <i class="fa fa-apple me-2"/>Apple Pay
                    </button>
                    <div class="nab-web-wallet-error text-danger small mt-2 d-none"/>
                </div>
              </t>
            </div>
          </div>

          <!-- Right Column - Booking Summary -->
          <div class="col-lg-5 col-md-5">
            <div class="salon-checkout-card p-4 sticky-top" style="top: 20px;">
              <h4 class="mb-3" style="font-weight: 600; color: #1a1a2e;">Booking Summary</h4>

              <!-- Branch Info -->
              <div class="d-flex align-items-center mb-3 pb-3" style="border-bottom: 1px solid #f0f0f0;">
                <div>
                  <div class="fw-semibold" style="font-size: 16px;" t-out="intent.branch_id.name"/>
                  <div class="small text-muted">
                    <t t-if="intent.branch_id.city" t-out="intent.branch_id.city"/>
                  </div>
                </div>
              </div>

              <!-- Appointment Date -->
              <div class="d-flex justify-content-between mb-2 pb-2" style="border-bottom: 1px solid #f0f0f0;">
                <span class="text-muted">Appointment Date</span>
                <span class="fw-semibold" t-out="intent.appointment_date"/>
              </div>
              <t t-set="first_line" t-value="intent.payload['lines'][0] if intent.payload.get('lines') else None"/>
              <div t-if="first_line" class="d-flex justify-content-between mb-3 pb-3" style="border-bottom: 1px solid #f0f0f0;">
                <span class="text-muted">Time</span>
                <span class="fw-semibold" t-out="'%02d:%02d' % (int(first_line['start_hour']), round(first_line['start_hour'] % 1 * 60))"/>
              </div>

              <!-- Services -->
              <div class="mb-3 pb-3" style="border-bottom: 1px solid #f0f0f0;">
                <div class="small text-muted text-uppercase fw-semibold mb-2">Services</div>
                <t t-foreach="intent.payload['lines']" t-as="line">
                  <div class="d-flex justify-content-between mb-2 salon-checkout-service-line">
                    <div>
                      <span class="fw-semibold" t-out="line['name']"/>
                      <t t-if="line.get('staff_name')">
                        <div class="small text-muted">
                          with <t t-out="line['staff_name']"/>
                        </div>
                      </t>
                    </div>
                    <div class="fw-semibold">
                      <t t-out="currency.symbol"/><t t-out="'{:.2f}'.format((line['base_price'] or 0.0) + (line.get('beautician_addon_price') or 0.0))"/>
                    </div>
                  </div>
                </t>
              </div>

              <!-- Price Breakdown -->
              <div class="mb-2">
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Services Total</span>
                  <span><t t-out="currency.symbol"/><t t-out="'{:.2f}'.format(intent.payload.get('service_total') or 0.0)"/></span>
                </div>
                <t t-if="intent.payload.get('booking_fee')">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Booking Fee</span>
                    <span><t t-out="currency.symbol"/><t t-out="'{:.2f}'.format(intent.payload['booking_fee'])"/></span>
                  </div>
                </t>
                <t t-if="intent.payload['totals'].get('discount_amount')">
                  <div class="d-flex justify-content-between mb-1" style="color: #10b981;">
                    <span>Discount</span>
                    <span>-<t t-out="currency.symbol"/><t t-out="'{:.2f}'.format(intent.payload['totals']['discount_amount'])"/></span>
                  </div>
                </t>
              </div>

              <!-- Payment Option Label -->
              <t t-if="intent.payload['booking']['payment_option'] == 'half'">
                <div class="d-flex justify-content-between mb-1">
                  <span class="text-muted">Payment Type</span>
                  <span class="badge bg-info text-white">Pay advance (50% deposit)</span>
                </div>
              </t>

              <!-- Amount to Pay -->
              <div class="d-flex justify-content-between pt-2 mt-2" style="border-top: 2px solid #e2e8f0;">
                <span class="fw-bold" style="font-size: 16px;">Amount to Pay</span>
                <span class="fw-bold" style="font-size: 20px; color: #10b981;">
                  <span t-field="intent.amount"/>
                </span>
              </div>

              <!-- Remaining Balance (for 50% deposits) -->
              <t t-if="intent.payload['booking']['payment_option'] == 'half'">
                <div class="d-flex justify-content-between mt-2 pt-2" style="border-top: 1px dashed #e2e8f0;">
                  <span class="text-muted small">Remaining Balance (pay at salon)</span>
                  <span class="text-muted small fw-semibold">
                    <t t-out="currency.symbol"/><t t-out="'{:.2f}'.format(intent.payload['totals']['total_after_discount'] - intent.amount)"/>
                  </span>
                </div>
              </t>
            </div>
          </div>
        </div>
      </div>
    </t>
  </template>

  <template id="checkout_result" name="Booking payment result">
    <t t-call="website.layout">
      <!-- The controller only passes intent + status (unlike secure_checkout,
           which also passes currency); derive it here instead. -->
      <t t-set="currency" t-value="intent.currency_id"/>
      <div class="spc-wrapper">
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-12 col-md-10 col-lg-7 col-xl-6">

              <!-- Status Header -->
              <div class="text-center spc-header">
                <t t-if="status == 'paid'">
                  <div class="spc-status-icon spc-status-success mx-auto">
                    <svg class="spc-checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
                      <circle class="spc-checkmark-circle" cx="26" cy="26" r="25" fill="none"/>
                      <path class="spc-checkmark-check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
                    </svg>
                  </div>
                  <h1 class="spc-title">Booking Confirmed!</h1>
                  <p class="spc-subtitle">Your payment was received and your appointment is booked.</p>
                  <span class="spc-badge spc-badge-success">Confirmed</span>
                </t>
                <t t-elif="status == 'refunded'">
                  <div class="spc-status-icon spc-status-error mx-auto">
                    <i class="fa fa-undo"></i>
                  </div>
                  <h1 class="spc-title">Your payment is being refunded</h1>
                  <p class="spc-subtitle">No booking was created. Contact the salon with your reference below for assistance.</p>
                  <span class="spc-badge spc-badge-error">Refunded</span>
                </t>
                <t t-elif="status == 'review'">
                  <div class="spc-status-icon spc-status-pending mx-auto">
                    <i class="fa fa-clock"></i>
                  </div>
                  <h1 class="spc-title">Payment received — booking needs assistance</h1>
                  <p class="spc-subtitle">Please contact the salon with your reference below. Do not pay again.</p>
                  <span class="spc-badge spc-badge-pending">Needs Attention</span>
                </t>
                <t t-elif="status in ('error', 'cancel', 'expired')">
                  <div class="spc-status-icon spc-status-error mx-auto">
                    <i class="fa fa-times"></i>
                  </div>
                  <h1 class="spc-title">Booking was not completed</h1>
                  <p class="spc-subtitle">No appointment has been created. You can choose your services and try again.</p>
                  <span class="spc-badge spc-badge-error">Not Completed</span>
                </t>
                <t t-else="">
                  <div class="spc-status-icon spc-status-pending mx-auto">
                    <i class="fa fa-clock"></i>
                  </div>
                  <h1 class="spc-title">Waiting for payment confirmation</h1>
                  <p class="spc-subtitle">Your booking will be saved once payment is confirmed. Please don't make another payment while this is processing.</p>
                  <span class="spc-badge spc-badge-pending">Processing</span>
                </t>
              </div>

              <!-- Booking Details Card -->
              <div class="spc-card">
                <div class="spc-card-header">
                  <h2 class="spc-card-title">Booking Details</h2>
                </div>
                <div class="spc-card-body">
                  <!-- Branch -->
                  <div class="spc-detail-row">
                    <div class="spc-detail-label">Salon</div>
                    <div class="spc-detail-value" t-out="intent.branch_id.name"/>
                    <t t-if="intent.branch_id.city">
                      <div class="spc-detail-meta" t-out="intent.branch_id.city"/>
                    </t>
                  </div>

                  <!-- Date -->
                  <div class="spc-detail-row">
                    <div class="spc-detail-label">Appointment Date</div>
                    <div class="spc-detail-value" t-out="intent.appointment_date"/>
                  </div>

                  <!-- Time -->
                  <t t-set="first_line" t-value="intent.payload['lines'][0] if intent.payload.get('lines') else None"/>
                  <div t-if="first_line" class="spc-detail-row">
                    <div class="spc-detail-label">Time</div>
                    <div class="spc-detail-value" t-out="'%02d:%02d' % (int(first_line['start_hour']), round(first_line['start_hour'] % 1 * 60))"/>
                  </div>

                  <!-- Customer (only once the booking is actually confirmed) -->
                  <t t-if="intent.appointment_id and intent.appointment_id.customer_id">
                    <div class="spc-detail-row">
                      <div class="spc-detail-label">Customer</div>
                      <div class="spc-detail-value" t-out="intent.appointment_id.customer_id.name"/>
                      <div class="spc-detail-meta" t-out="intent.appointment_id.customer_id.email"/>
                    </div>
                  </t>

                  <!-- Services -->
                  <div class="spc-detail-row">
                    <div class="spc-detail-label">Services</div>
                    <t t-foreach="intent.payload['lines']" t-as="line">
                      <div class="spc-service-line">
                        <div>
                          <span class="spc-detail-value" t-out="line['name']"/>
                          <t t-if="line.get('staff_name')">
                            <span class="spc-detail-meta"> with <t t-out="line['staff_name']"/></span>
                          </t>
                        </div>
                        <span class="spc-service-price">
                          <t t-out="currency.symbol"/><t t-out="'{:.2f}'.format((line['base_price'] or 0.0) + (line.get('beautician_addon_price') or 0.0))"/>
                        </span>
                      </div>
                    </t>
                  </div>

                  <!-- Payment Summary -->
                  <div class="spc-payment-summary">
                    <div class="spc-payment-row">
                      <span>Payment Method</span>
                      <span class="fw-semibold">Online</span>
                    </div>
                    <t t-if="intent.payload['booking']['payment_option'] == 'half'">
                      <div class="spc-payment-row">
                        <span>Payment Type</span>
                        <span class="spc-badge spc-badge-pending" style="font-size: 11px; padding: 3px 10px;">Pay advance (50% deposit)</span>
                      </div>
                    </t>
                    <div class="spc-payment-total">
                      <span>Payment Amount</span>
                      <span class="spc-amount-paid">
                        <span t-field="intent.amount"/>
                      </span>
                    </div>
                    <t t-if="intent.payload['booking']['payment_option'] == 'half'">
                      <div class="spc-payment-row spc-payment-row-muted">
                        <span>Remaining Balance (pay at salon)</span>
                        <span>
                          <t t-out="currency.symbol"/><t t-out="'{:.2f}'.format(intent.payload['totals']['total_after_discount'] - intent.amount)"/>
                        </span>
                      </div>
                    </t>
                    <t t-if="intent.appointment_id and intent.appointment_id.appointment_ref">
                      <div class="spc-payment-row spc-payment-row-muted">
                        <span>Appointment Reference</span>
                        <span t-out="intent.appointment_id.appointment_ref"/>
                      </div>
                    </t>
                    <t t-else="">
                      <div class="spc-payment-row spc-payment-row-muted">
                        <span>Checkout Reference</span>
                        <span t-out="intent.name"/>
                      </div>
                    </t>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <t t-if="status == 'paid'">
                <div class="text-center spc-actions">
                  <a href="/book-online" class="spc-new-btn">
                    <i class="fa fa-plus"></i>
                    New Appointment
                  </a>
                  <div class="spc-print-wrap">
                    <a href="javascript:void(0);" class="spc-print-link" onclick="window.print();">Print confirmation</a>
                  </div>
                </div>
              </t>
              <t t-elif="status in ('error', 'cancel', 'expired')">
                <div class="text-center spc-actions">
                  <a href="/book-online" class="spc-new-btn">
                    <i class="fa fa-plus"></i>
                    Start a new booking
                  </a>
                </div>
              </t>
              <t t-elif="status not in ('review', 'refunded')">
                <div class="text-center spc-actions">
                  <a class="spc-new-btn" t-att-href="'/salon/checkout-result/%s?access_token=%s' % (intent.id, intent.access_token)">
                    <i class="fa fa-refresh"></i>
                    Check payment status
                  </a>
                </div>
              </t>

            </div>
          </div>
        </div>
      </div>

      <style>
        .spc-wrapper {
          min-height: 80vh;
          padding: 40px 16px;
          background: #fafbfc;
        }

        .spc-header {
          margin-bottom: 28px;
        }

        /* Status Icons */
        .spc-status-icon {
          width: 84px;
          height: 84px;
          border-radius: 50%;
          display: flex;
          align-items: center;
          justify-content: center;
          margin-bottom: 18px;
          animation: spcScaleIn 0.5s ease-out;
        }

        .spc-status-icon i {
          font-size: 36px;
          color: #fff;
        }

        .spc-status-success {
          background: #10b981;
          box-shadow: 0 12px 32px rgba(16, 185, 129, 0.35);
        }

        .spc-status-pending {
          background: #f59e0b;
          box-shadow: 0 12px 32px rgba(245, 158, 11, 0.3);
        }

        .spc-status-error {
          background: #ef4444;
          box-shadow: 0 12px 32px rgba(239, 68, 68, 0.3);
        }

        /* Animated Checkmark */
        .spc-checkmark {
          width: 46px;
          height: 46px;
        }

        .spc-checkmark-circle {
          stroke-dasharray: 166;
          stroke-dashoffset: 166;
          stroke-width: 2;
          stroke-miterlimit: 10;
          stroke: rgba(255,255,255,0.3);
          animation: spcCircle 0.6s ease-in-out 0.3s forwards;
        }

        .spc-checkmark-check {
          stroke-dasharray: 48;
          stroke-dashoffset: 48;
          stroke: #fff;
          stroke-width: 3;
          stroke-linecap: round;
          stroke-linejoin: round;
          animation: spcCheck 0.4s ease-in-out 0.7s forwards;
        }

        @keyframes spcScaleIn {
          0% { transform: scale(0); opacity: 0; }
          60% { transform: scale(1.1); }
          100% { transform: scale(1); opacity: 1; }
        }

        @keyframes spcCircle {
          100% { stroke-dashoffset: 0; }
        }

        @keyframes spcCheck {
          100% { stroke-dashoffset: 0; }
        }

        .spc-title {
          font-size: 26px;
          font-weight: 700;
          color: #1e293b;
          margin-bottom: 6px;
        }

        .spc-subtitle {
          font-size: 15px;
          color: #64748b;
          margin-bottom: 12px;
        }

        /* Status Badges */
        .spc-badge {
          display: inline-block;
          padding: 4px 14px;
          font-size: 12px;
          font-weight: 700;
          text-transform: uppercase;
          letter-spacing: 0.5px;
          border-radius: 20px;
        }

        .spc-badge-success {
          background: #dcfce7;
          color: #166534;
        }

        .spc-badge-pending {
          background: #fef3c7;
          color: #92400e;
        }

        .spc-badge-error {
          background: #fee2e2;
          color: #991b1b;
        }

        /* Card */
        .spc-card {
          background: #fff;
          border-radius: 14px;
          box-shadow: 0 4px 16px rgba(0,0,0,0.07);
          overflow: hidden;
        }

        .spc-card-header {
          padding: 18px 22px;
          border-bottom: 1px solid #f1f5f9;
        }

        .spc-card-title {
          font-size: 18px;
          font-weight: 600;
          color: #1e293b;
          margin: 0;
        }

        .spc-card-body {
          padding: 0;
        }

        /* Detail Rows */
        .spc-detail-row {
          padding: 14px 22px;
          border-bottom: 1px solid #f1f5f9;
        }

        .spc-detail-row:last-child {
          border-bottom: none;
        }

        .spc-detail-label {
          font-weight: 600;
          color: #94a3b8;
          font-size: 11px;
          text-transform: uppercase;
          letter-spacing: 0.6px;
          margin-bottom: 3px;
        }

        .spc-detail-value {
          color: #1e293b;
          font-size: 15px;
          font-weight: 500;
        }

        .spc-detail-meta {
          color: #94a3b8;
          font-size: 13px;
        }

        .spc-service-line {
          display: flex;
          justify-content: space-between;
          align-items: flex-start;
          margin-bottom: 6px;
        }

        .spc-service-line:last-child {
          margin-bottom: 0;
        }

        .spc-service-price {
          font-weight: 600;
          color: #1e293b;
          font-size: 15px;
          white-space: nowrap;
          margin-left: 12px;
        }

        /* Payment Summary */
        .spc-payment-summary {
          background: #f8fafc;
          padding: 18px 22px;
        }

        .spc-payment-row {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 7px 0;
          font-size: 14px;
          color: #475569;
        }

        .spc-payment-row-muted {
          font-size: 13px;
          color: #94a3b8;
        }

        .spc-payment-total {
          display: flex;
          justify-content: space-between;
          align-items: center;
          padding: 12px 0 6px;
          margin-top: 6px;
          border-top: 2px solid #e2e8f0;
          font-weight: 700;
          font-size: 16px;
          color: #1e293b;
        }

        .spc-amount-paid {
          font-size: 18px;
          color: #10b981;
        }

        /* Actions */
        .spc-actions {
          margin-top: 28px;
        }

        .spc-new-btn {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          padding: 10px 22px;
          font-size: 14px;
          font-weight: 600;
          color: #6366f1;
          background: transparent;
          border: 2px solid #6366f1;
          border-radius: 8px;
          text-decoration: none;
          transition: all 0.2s ease;
        }

        .spc-new-btn:hover {
          background: #6366f1;
          color: #fff;
          text-decoration: none;
        }

        .spc-new-btn i {
          font-size: 12px;
        }

        .spc-print-wrap {
          margin-top: 12px;
        }

        .spc-print-link {
          font-size: 13px;
          color: #94a3b8;
          text-decoration: none;
          transition: color 0.2s;
        }

        .spc-print-link:hover {
          color: #64748b;
          text-decoration: underline;
        }

        /* Responsive */
        @media (min-width: 768px) {
          .spc-title { font-size: 30px; }
          .spc-status-icon { width: 92px; height: 92px; }
          .spc-status-icon i { font-size: 40px; }
          .spc-checkmark { width: 50px; height: 50px; }
          .spc-card-header { padding: 20px 26px; }
          .spc-detail-row { padding: 16px 26px; }
          .spc-payment-summary { padding: 20px 26px; }
        }

        @media (max-width: 767px) {
          .spc-wrapper { padding: 20px 12px; }
          .spc-status-icon { width: 72px; height: 72px; }
          .spc-status-icon i { font-size: 32px; }
          .spc-checkmark { width: 40px; height: 40px; }
          .spc-title { font-size: 22px; }
          .spc-subtitle { font-size: 14px; }
          .spc-detail-row { padding: 12px 16px; }
          .spc-card-header { padding: 14px 16px; }
          .spc-card-title { font-size: 16px; }
          .spc-payment-summary { padding: 14px 16px; }
          .spc-new-btn { padding: 10px 20px; font-size: 13px; }
        }

        @media (max-width: 375px) {
          .spc-wrapper { padding: 16px 8px; }
          .spc-title { font-size: 20px; }
        }
      </style>
    </t>
  </template>

  <record id="view_online_checkout_list" model="ir.ui.view">
    <field name="name">bb.online.booking.intent.list</field><field name="model">bb.online.booking.intent</field>
    <field name="arch" type="xml"><list create="0" edit="0" delete="0" decoration-danger="state == 'review'">
      <field name="name"/><field name="branch_id"/><field name="appointment_date"/><field name="amount"/>
      <field name="currency_id" column_invisible="True"/><field name="state"/><field name="appointment_id"/>
